# =============================================================================
# PersonaForge Web App — Environment Variables Template
# =============================================================================
# DO NOT COMMIT SENSITIVE SECRETS. Copy to .env.local for local development.

# Public Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth & Database (Leave blank for offline mock mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (For distributed rate-limiting & key-pool state; falls back to in-memory if empty)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Groq Key Pool (Comma-separated API keys, up to 10 keys; aliased k1..k10 in logs)
GROQ_API_KEYS=gsk_mock_key1,gsk_mock_key2
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,llama-3.2-11b-vision-preview
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Sarvam AI (For Voice STT / TTS)
SARVAM_API_KEY=your-sarvam-key
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3

# Platform Internal Communication Secret (Shared with services/whatsapp-gateway)
INTERNAL_API_SECRET=dev_internal_secret_change_in_prod

# Token Security Salts
PUBLIC_TOKEN_PEPPER=dev_token_pepper_change_in_prod
PHONE_HASH_SALT=dev_phone_salt_change_in_prod

# Admin Emails (Comma-separated)
ADMIN_EMAILS=admin@example.com
