# =============================================================================
# PersonaForge WhatsApp Gateway — Environment Variables
# =============================================================================
# Copy this file to .env for local development. DO NOT commit actual secrets.

# Twilio Credentials (from Twilio Console)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000000000000000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_KEYWORD=join example-word

# Public Gateway URL (ngrok in dev, Render/Fly in prod) - used for signature validation & audio URLs
PUBLIC_BASE_URL=http://localhost:8000

# Sarvam AI Credentials (for STT and TTS)
SARVAM_API_KEY=mock-sarvam-key-for-dev
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3

# Platform Brain Connection (Next.js backend)
PLATFORM_URL=http://localhost:3000
INTERNAL_API_SECRET=dev_internal_secret_change_in_prod

# Persistence & Security
REDIS_URL=redis://localhost:6379
PHONE_HASH_SALT=dev_salt_change_in_prod

# Development Flags
# Set to 'true' only in local development to bypass X-Twilio-Signature validation
DEV_SKIP_SIGNATURE=true

# Server Port
PORT=8000
