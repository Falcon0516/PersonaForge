# =============================================================================
# PersonaForge — Environment Variables Reference
# =============================================================================
# COPY THIS FILE TO .env IN RESPECTIVE DIRECTORIES (DO NOT COMMIT REAL .env)
#
# apps/web requires:
#   NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#   SUPABASE_SERVICE_ROLE_KEY, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN,
#   GROQ_API_KEYS, GROQ_DEFAULT_MODEL, GROQ_FALLBACK_MODELS, GROQ_VISION_MODEL,
#   SARVAM_API_KEY, SARVAM_STT_MODEL, SARVAM_TTS_MODEL,
#   INTERNAL_API_SECRET, PUBLIC_TOKEN_PEPPER, PHONE_HASH_SALT, ADMIN_EMAILS
#
# services/whatsapp-gateway requires:
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM,
#   TWILIO_SANDBOX_KEYWORD, PUBLIC_BASE_URL,
#   SARVAM_API_KEY, SARVAM_STT_MODEL, SARVAM_TTS_MODEL,
#   PLATFORM_URL, INTERNAL_API_SECRET, REDIS_URL,
#   PHONE_HASH_SALT, DEV_SKIP_SIGNATURE, PORT
# =============================================================================

# See apps/web/.env.example and services/whatsapp-gateway/.env.example for details.
